# Copy to .env. Keep real keys out of this file.

# ---------- Model (optional; without it the fixture provider runs every agent deterministically) ----------
# Azure AI Foundry / Azure OpenAI v1 endpoint (api-key header is chosen automatically for *.azure.com)
PEV2_LLM_PROVIDER=fixture            # fixture | openai_compatible
PEV2_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
PEV2_LLM_API_KEY=
PEV2_LLM_MODEL=gpt-6-sol
# Leave unset for models that only accept their default temperature
# PEV2_LLM_TEMPERATURE=0.2

# ---------- Runtime ----------
PEV2_DB=data/runtime/pev2.db          # SQLite file: the workflow state store, the mocks and the audit log
PEV2_CLOCK=2026-10-20T08:00:00Z       # "today" for the simulation; unset = real time
PEV2_PAYMENT_RUN_WEEKDAY=thursday
PEV2_RETRY_SLEEP=0                    # seconds between tool retries (0 for tests)
